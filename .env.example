# =============================================================================
# Uni Pasco Hub — Environment Variables
# Copy this file to `.env` and fill in values for local development.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required)
# Obtain: Docker Compose Postgres (see docs/development.md) or any PostgreSQL 18+
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/unipascohub"

# -----------------------------------------------------------------------------
# Clerk (required)
# Obtain: https://dashboard.clerk.com → your application → API Keys
# Webhook signing secret: Clerk Dashboard → Webhooks → endpoint for /api/webhooks
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# -----------------------------------------------------------------------------
# Cloudinary (required for file uploads)
# Obtain: https://console.cloudinary.com → Dashboard + Settings → Upload presets
# Create a signed upload preset and set CLOUDINARY_UPLOAD_PRESET to its name.
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_UPLOAD_PRESET="your-signed-upload-preset"

# Alternative: set CLOUDINARY_URL instead of the three vars above
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# -----------------------------------------------------------------------------
# Sentry (optional — error monitoring for production)
# Obtain: https://sentry.io → create a project → copy DSN
# SENTRY_ORG and SENTRY_PROJECT are required for source map uploads during build.
# SENTRY_AUTH_TOKEN is a project-level auth token from Sentry.
# -----------------------------------------------------------------------------
# SENTRY_DSN="https://<key>@o<orgId>.ingest.sentry.io/<projectId>"
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<orgId>.ingest.sentry.io/<projectId>"
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="your-project-slug"
# SENTRY_AUTH_TOKEN="your-auth-token"

# -----------------------------------------------------------------------------
# PostHog (optional — client-side product analytics)
# Obtain: https://posthog.com → your project → Settings → Project API key and
# web snippet host. NEXT_PUBLIC_POSTHOG_HOST is your PostHog region endpoint
# (e.g. https://us.i.posthog.com or https://eu.i.posthog.com). Analytics
# requests are reverse-proxied through /ingest (see next.config.ts).
# Leave both unset to disable PostHog completely (it stays inert).
# Set NEXT_PUBLIC_POSTHOG_ENABLED=false to force-disable even when configured.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY="phc_..."
# NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# NEXT_PUBLIC_POSTHOG_ENABLED="true"

# -----------------------------------------------------------------------------
# Redis (optional — recommended for production rate limiting)
# Uses Upstash's HTTP/REST client (stateless — correct for serverless; a TCP
# client gets its socket frozen/dropped on Vercel). Copy UPSTASH_REDIS_REST_URL
# and UPSTASH_REDIS_REST_TOKEN from your database's "REST API" section in the
# Upstash console (https://console.upstash.com/redis). If unset, rate limiting
# falls back to in-memory (single-instance only).
# -----------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-rest-token"

# -----------------------------------------------------------------------------
# Pasco file limits (optional — defaults shown)
# -----------------------------------------------------------------------------
# PASCO_MAX_FILES_PER_PASCO=10
# PASCO_MAX_FILE_SIZE_BYTES=5242880
# PASCO_DOWNLOAD_URL_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Rate limits (optional — defaults shown)
# Window values are in milliseconds.
# -----------------------------------------------------------------------------
# CLOUDINARY_SIGN_RATE_LIMIT=30
# CLOUDINARY_SIGN_RATE_WINDOW_MS=900000
# PASCO_REACTION_RATE_LIMIT=60
# PASCO_REACTION_RATE_WINDOW_MS=900000
# PASCO_DOWNLOAD_RATE_LIMIT=120
# PASCO_DOWNLOAD_RATE_WINDOW_MS=900000
# PASCO_VIEW_DEDUPE_WINDOW_MS=3600000
# PASCO_VIEW_GLOBAL_RATE_LIMIT=300
# PASCO_VIEW_GLOBAL_RATE_WINDOW_MS=900000
# PASCO_LIST_RATE_LIMIT=120
# PASCO_LIST_RATE_WINDOW_MS=900000
# PASCO_CREATE_RATE_LIMIT=10
# PASCO_CREATE_RATE_WINDOW_MS=900000
# CATALOG_SUBMISSION_CREATE_RATE_LIMIT=10
# CATALOG_SUBMISSION_CREATE_RATE_WINDOW_MS=900000
# UPGRADE_TO_CONTRIBUTOR_RATE_LIMIT=3
# UPGRADE_TO_CONTRIBUTOR_RATE_WINDOW_MS=900000

# -----------------------------------------------------------------------------
# Moderation (optional — defaults shown)
# -----------------------------------------------------------------------------
# MODERATION_DISLIKE_THRESHOLD=5

# -----------------------------------------------------------------------------
# Application URL (required for CSRF origin validation in production)
# Set to your deployed domain (e.g. https://unipascohub.vercel.app).
# Falls back to VERCEL_URL on Vercel, or localhost in dev.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL="https://your-domain.com"

# -----------------------------------------------------------------------------
# Site links (optional — footer/social; client-safe)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_BMC_URL="https://buymeacoffee.com/yourhandle"
# NEXT_PUBLIC_GITHUB_URL="https://github.com/weamp-org/unipascohub"
# NEXT_PUBLIC_TWITTER_URL="https://twitter.com/yourhandle"
# NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/in/yourhandle"
# -----------------------------------------------------------------------------
# VAPID Keys for Web Push (required for push notifications)
# Generate: pnpm exec web-push generate-vapid-keys (or use web-push CLI)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
# VAPID_PRIVATE_KEY="your-vapid-private-key"
