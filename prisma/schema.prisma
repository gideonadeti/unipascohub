generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  NORMAL_USER
  CONTRIBUTOR // can upload
  MODERATOR
  ADMIN
}

enum ProgramType {
  BACHELOR
  BTECH
  BTECH_TOP_UP
  HND
  DIPLOMA
}

enum EducationLevel {
  LEVEL_100
  LEVEL_200
  LEVEL_300
  LEVEL_400
}

enum SemesterType {
  FIRST_SEMESTER
  SECOND_SEMESTER
}

enum PascoType {
  MID_SEM
  END_OF_SEM
}

enum PascoContentType {
  QUESTIONS_ONLY
  QUESTIONS_AND_ANSWERS
  ANSWERS_ONLY
}

enum SolutionCompleteness {
  FULLY_SOLVED
  PARTIALLY_SOLVED
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  name      String
  school    String?
  role      UserRole @default(NORMAL_USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pascos Pasco[]
}

model Institution {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs Program[]
  courses  Course[]

  @@unique([name])
}

model Program {
  id            String      @id @default(cuid())
  institutionId String
  name          String
  type          ProgramType
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  courses     Course[]

  @@unique([institutionId, name, type])
  @@index([institutionId, type])
}

model Course {
  id            String   @id @default(cuid())
  institutionId String
  code          String
  title         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  programs    Program[]
  pascos      Pasco[]

  @@unique([institutionId, code])
}

model Pasco {
  id                   String                @id @default(cuid())
  courseId             String
  uploaderId           String?
  publicId             String                @unique // Cloudinary public id
  fileName             String
  fileSize             Int
  fileExtension        String
  fileUrl              String
  year                 Int
  description          String?
  educationLevel       EducationLevel
  semesterType         SemesterType
  type                 PascoType
  contentType          PascoContentType
  solutionCompleteness SolutionCompleteness?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  uploader User?  @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([courseId, educationLevel, year])
  @@index([uploaderId])
  @@index([createdAt(sort: Desc)])
}
